# PostgreSQL connection string for the main application database.
DATABASE_URL="postgresql://user:password@localhost:5432/dala_dev?schema=public"

# Separate PostgreSQL database used as the sandbox for the SQL Playground.
# Never point this at your production database - see ARCHITECTURE.md > SQL Sandbox.
SANDBOX_DATABASE_URL="postgresql://user:password@localhost:5432/dala_sandbox?schema=public"

# Auth.js secret used to sign session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Public URL of the deployment, required by Auth.js.
NEXTAUTH_URL="http://localhost:3000"
